# --- Foundry environment (copy to .env for local dev) ---

# Postgres
POSTGRES_USER=foundry
POSTGRES_PASSWORD=foundry
POSTGRES_DB=foundry
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Constructed from the above. In compose, services use "postgres" host.
DATABASE_URL=postgresql+asyncpg://foundry:foundry@postgres:5432/foundry
DATABASE_URL_SYNC=postgresql+psycopg://foundry:foundry@postgres:5432/foundry

# Redis
REDIS_URL=redis://redis:6379/0

# API
FOUNDRY_API_HOST=0.0.0.0
FOUNDRY_API_PORT=8000
FOUNDRY_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FOUNDRY_ENV=development
FOUNDRY_LOG_LEVEL=INFO
FOUNDRY_SECRET_KEY=change-me-in-production

# Repo storage (inside container)
FOUNDRY_REPOS_DIR=/var/lib/foundry/repos

# Stale thresholds (days)
FOUNDRY_STALE_DAYS_WARN=14
FOUNDRY_STALE_DAYS_CRITICAL=45

# Web (Vite)
VITE_API_BASE_URL=http://localhost:8000
