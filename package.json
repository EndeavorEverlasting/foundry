{
  "name": "foundry",
  "private": true,
  "version": "0.1.0",
  "description": "Foundry platform monorepo: BranchFoundry, GuardFoundry, FoundryHooks",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/compose/docker-compose.yml down",
    "compose:logs": "docker compose -f infra/compose/docker-compose.yml logs -f",
    "api:gen-client": "pnpm --filter @foundry/ui gen-client",
    "py:lint": "uv run ruff check .",
    "py:format": "uv run ruff format .",
    "py:typecheck": "uv run mypy apps packages",
    "py:test": "uv run pytest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "eslint": "^9.15.0",
    "@types/node": "^22.9.0"
  }
}
